# Exclude frontend HTML from GitHub repository language statistics
*.html linguist-vendored=true
*.html linguist-detectable=false

# Exclude JSON workflows and Terraform configs from language stats
*.json linguist-vendored=true
*.json linguist-detectable=false
*.tf linguist-vendored=true
*.tf linguist-detectable=false

# Prioritize Python and Docker
*.py linguist-detectable=true
Dockerfile linguist-detectable=true

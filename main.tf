# =============================================================================
#  ZenInbox — Terraform Infrastructure Blueprint
#  Provider: hashicorp/local
#  Architecture: FastAPI + n8n Workflow Automation + Ollama Gemma 2 + SQLite3
# =============================================================================

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "local" {}

# ---------------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------------

variable "project_name" {
  description = "Canonical project identifier."
  type        = string
  default     = "zeninbox"
}

variable "environment" {
  description = "Deployment environment label."
  type        = string
  default     = "production-local"
}

variable "app_port" {
  description = "Port the FastAPI engine & UI listen on."
  type        = number
  default     = 8000
}

variable "n8n_port" {
  description = "Port the n8n automation engine listens on."
  type        = number
  default     = 5678
}

variable "ollama_model" {
  description = "Ollama model tag used for email analysis."
  type        = string
  default     = "gemma2:2b"
}

variable "db_filename" {
  description = "SQLite database filename."
  type        = string
  default     = "zen_inbox.db"
}

variable "manifest_path" {
  description = "Output path for the architecture manifest JSON."
  type        = string
  default     = "architecture_manifest.json"
}

# ---------------------------------------------------------------------------
# Locals — assemble the full manifest payload
# ---------------------------------------------------------------------------

locals {
  timestamp = timestamp()

  workspace_status = [
    {
      component   = "n8n-workflow-orchestrator"
      description = "Visual workflow automation engine orchestrating email ingestion, webhook triggers, and Ollama tasks."
      status      = "active"
      port        = var.n8n_port
      endpoint    = "http://localhost:5678"
      workflow    = "n8n_zeninbox_workflow.json"
    },
    {
      component   = "fastapi-engine"
      description = "Lightweight ASGI REST API, webhooks handler, and administrative event journal."
      status      = "active"
      port        = var.app_port
      entrypoint  = "app.py"
    },
    {
      component   = "ollama-gemma2"
      description = "Local LLM inference engine stripping panic jargon and extracting structured JSON."
      status      = "required"
      model       = var.ollama_model
      endpoint    = "http://localhost:11434"
      temperature = 0.1
    },
    {
      component   = "sqlite-cache"
      description = "Zero-latency local database for structured email records and audit event history."
      status      = "active"
      filename    = var.db_filename
      schema      = "emails, users, audit_logs, config"
    },
    {
      component   = "desktop-notifier"
      description = "Native Windows/OS toast alert dispatcher on new message de-escalation."
      status      = "active"
      engine      = "win11toast / plyer"
    }
  ]

  architecture_manifest = {
    project     = var.project_name
    environment = var.environment
    version     = "4.0.0"
    generated   = local.timestamp
    description = "ZenInbox architecture manifest with n8n orchestration — auto-generated by Terraform."
    stack = {
      ui           = "Enterprise Console (Tailwind CSS)"
      orchestrator = "n8n Workflow Automation"
      backend      = "FastAPI + Uvicorn"
      runtime      = "docker-compose (FastAPI + n8n)"
      iac          = "terraform >= 1.5 + hashicorp/local"
    }
    workspace_status = local.workspace_status
    ports = {
      zeninbox = var.app_port
      n8n      = var.n8n_port
      ollama   = 11434
    }
    volumes = [
      "zeninbox_data — persistent SQLite store",
      "n8n_data — persistent workflow & execution state"
    ]
    notes = [
      "n8n orchestrates incoming email streams and forwards sanitized payloads to ZenInbox.",
      "FastAPI receives webhooks at /api/webhook/n8n.",
      "All processing happens on-device; zero cloud telemetry."
    ]
  }
}

# ---------------------------------------------------------------------------
# Resource — write the manifest to disk
# ---------------------------------------------------------------------------

resource "local_file" "architecture_manifest" {
  filename        = var.manifest_path
  content         = jsonencode(local.architecture_manifest)
  file_permission = "0644"
}

# ---------------------------------------------------------------------------
# Outputs
# ---------------------------------------------------------------------------

output "manifest_file" {
  description = "Path to the generated architecture manifest."
  value       = local_file.architecture_manifest.filename
}

output "workspace_components" {
  description = "List of tracked workspace components and their status."
  value       = [for ws in local.workspace_status : "${ws.component} → ${ws.status}"]
}

output "generated_at" {
  description = "UTC timestamp when the manifest was generated."
  value       = local.timestamp
}
